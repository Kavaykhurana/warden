# Copy to backend/.env (git-ignored). Spring Boot reads it via spring.config.import.

# Google AI Studio key. Never commit a real one.
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.8-flash

# HS256 signing secret, at least 256 bits, base64. Generate with: openssl rand -base64 48
JWT_SECRET=

DATABASE_URL=jdbc:postgresql://localhost:5432/warden
DATABASE_USERNAME=warden
DATABASE_PASSWORD=warden

# true behind HTTPS (production); false for http://localhost
COOKIE_SECURE=false
SEED_DEMO_DATA=true
